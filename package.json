{
  "name": "bettergit",
  "productName": "BetterGit",
  "version": "0.1.0",
  "private": true,
  "description": "Mac-only Git client with a multi-repo sidebar, inspired by Sublime Merge.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "release:mac": "scripts/release-mac.sh",
    "start": "electron-vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sample": "bun scripts/create-sample-workspace.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.58.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ],
  "build": {
    "appId": "com.wrick17.bettergit",
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": true,
      "writeUpdateInfo": false
    }
  }
}
